# Copy to .env.smtp, which must stay uncommitted. Use only a test inbox you control.
DEMO_MAIL_MODE=smtp
DEMO_EMAIL=your-private-test-inbox@mailsac.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASSWORD=replace-locally
SMTP_FROM=Your Example App <sender@example.com>
MAILSAC_API_KEY=replace-locally
